{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PropertyProDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "ApplyMigrations": true,
    "SeedSystemData": true,
    "SeedDemoData": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "propertypro",
    "SecretKey": "propertypro-dev-password",
    "BucketName": "propertypro",
    "UseSsl": false
  },
  "Jwt": {
    "SecretKey": "PropertyPro-Development-Secret-Key-Change-This-At-Least-32-Chars",
    "Issuer": "PropertyPro.Api",
    "Audience": "PropertyPro.Client",
    "ExpirationMinutes": 60
  },
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "AllowedHosts": "*"
}
